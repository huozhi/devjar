{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "devjar": ["./src/index.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true
  },
  "include": ["src"]
}
