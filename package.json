{
  "name": "devjar",
  "version": "0.11.0",
  "description": "Zero-config React static site builder.",
  "keywords": [
    "react",
    "static-site-generator",
    "ssg",
    "prototype",
    "playground",
    "code-editor"
  ],
  "homepage": "https://github.com/huozhi/devjar#readme",
  "bugs": {
    "url": "https://github.com/huozhi/devjar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huozhi/devjar.git"
  },
  "license": "MIT",
  "author": "huozhi",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "jar": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:client && pnpm run build:cli-assets && pnpm run build:worker",
    "build:lib": "bunchee",
    "build:client": "bun scripts/build-client.ts",
    "build:cli-assets": "bun scripts/build-cli-assets.ts",
    "build:worker": "bun scripts/build-workers.ts",
    "prepublishOnly": "pnpm run build",
    "build:website": "pnpm run build && node ./dist/bin.js build site --out-dir dist",
    "start": "node ./dist/bin.js start site/dist",
    "dev": "pnpm run build && (pnpm run dev:lib & pnpm run dev:client & pnpm run dev:worker & pnpm run dev:site & wait)",
    "dev:lib": "bunchee --watch",
    "dev:client": "bun scripts/build-client.ts --watch",
    "dev:worker": "bun --watch scripts/build-workers.ts",
    "dev:site": "node ./dist/bin.js dev site",
    "dev:cli": "node ./dist/bin.js dev examples/dashboard",
    "demo:build": "node ./dist/bin.js build examples/dashboard",
    "demo:start": "node ./dist/bin.js start examples/dashboard/dist",
    "test": "bun test",
    "test:package": "bun scripts/check-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "es-module-lexer": "1.6.0",
    "oxc-minify": "0.148.0",
    "oxc-transform": "^0.144.0"
  },
  "devDependencies": {
    "@oxc-transform/binding-wasm32-wasi": "0.144.0",
    "@playwright/test": "^1.62.1",
    "@sugar-high/react": "2.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript/typescript6": "6.0.2",
    "bunchee": "^7.0.1",
    "dedent": "^1.7.0",
    "devjar": "link:",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sugar-high": "2.2.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0"
}
